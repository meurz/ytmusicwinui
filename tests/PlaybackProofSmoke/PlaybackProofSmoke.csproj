<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ServiceDirectory Condition="'$(ServiceDirectory)' == ''">$(MSBuildThisFileDirectory)../../src/Music.Desktop/Services</ServiceDirectory>
    <ModelsDirectory Condition="'$(ModelsDirectory)' == ''">$(MSBuildThisFileDirectory)../../src/Music.Desktop/Models</ModelsDirectory>
    <CoreInteropProject Condition="'$(CoreInteropProject)' == ''">$(MSBuildThisFileDirectory)../../external/core/examples/dotnet/windows/YouTubeMusic.Interop.Windows.csproj</CoreInteropProject>
    <NativeCoreDirectory Condition="'$(NativeCoreDirectory)' == ''">$(MSBuildThisFileDirectory)../../.native/$(RuntimeIdentifier)</NativeCoreDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <ProjectReference Include="$(CoreInteropProject)" />
    <Compile Include="$(ServiceDirectory)/CoreService.cs" Link="Services/CoreService.cs" />
    <Compile Include="$(ServiceDirectory)/SessionStore.cs" Link="Services/SessionStore.cs" />
    <Compile Include="$(ServiceDirectory)/PlaybackProofProvider.cs" Link="Services/PlaybackProofProvider.cs" />
    <Compile Include="$(ServiceDirectory)/PlaybackService.cs" Link="Services/PlaybackService.cs" />
    <Compile Include="$(ModelsDirectory)/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Content Include="$(NativeCoreDirectory)/youtube_music_core.dll" Link="youtube_music_core.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NativeCoreDirectory)/po-provider/**/*" Link="po-provider/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireNativeCore" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(NativeCoreDirectory)/youtube_music_core.dll')" Text="Build or bootstrap the candidate core before running this check." />
  </Target>
</Project>
